# Flask 세션 서명에 쓰는 비밀키. 운영에서는 긴 무작위 문자열로 바꾸세요.
SECRET_KEY=replace-with-a-long-random-string

# 데이터베이스 주소. 로컬은 SQLite, 운영은 Supabase 등 PostgreSQL URL을 넣으세요.
DATABASE_URL=sqlite:///instance/learning.db

# 이 값이 있을 때만 시작 시 관리자 계정을 만듭니다. 강한 비밀번호로 바꾸세요.
ADMIN_PASSWORD=replace-with-a-strong-password

# 관리자 아이디. 생략하면 admin 을 사용합니다.
ADMIN_USERNAME=admin
